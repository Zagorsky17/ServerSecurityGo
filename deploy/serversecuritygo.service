# systemd-юнит ServerSecurityGo.
# Устанавливается скриптом scripts/install.sh в /etc/systemd/system/.
#
# Служба работает от root: только root видит exe, cwd, открытые файлы и
# окружение процессов других пользователей. Чтобы ограничить последствия
# возможной уязвимости, права root урезаны: оставлены лишь возможности
# чтения чужих процессов, файловая система смонтирована только для чтения
# (кроме каталога данных), запрещено получение новых привилегий.
[Unit]
Description=ServerSecurityGo — мониторинг и анализ процессов
Documentation=https://github.com/Zagorsky17/ServerSecurityGo
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/serversecuritygo
EnvironmentFile=/opt/serversecuritygo/.env
ExecStart=/opt/serversecuritygo/bin/serversecuritygo serve
Restart=on-failure
RestartSec=5s
# Логи уходят в journald (journalctl -u serversecuritygo); ротацию
# выполняет journald, файлов в каталоге проекта нет.
StandardOutput=journal
StandardError=journal

# Каталог данных /var/lib/serversecuritygo создаётся systemd с правами 700.
StateDirectory=serversecuritygo
StateDirectoryMode=0700
# /run/serversecuritygo (0700) — для Unix-сокета api.sock, через который
# терминальный интерфейс (команда serversecuritygo) получает данные службы.
# Каталог удаляется systemd при остановке службы.
RuntimeDirectory=serversecuritygo
RuntimeDirectoryMode=0700

# --- Ограничения ---
# CAP_SYS_PTRACE — readlink /proc/PID/exe и чтение fd/environ чужих процессов;
# CAP_DAC_READ_SEARCH — чтение файлов автозапуска и authorized_keys;
# CAP_NET_BIND_SERVICE — если панель повесят на порт < 1024.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/serversecuritygo
# Домашние каталоги нужны только для чтения authorized_keys.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @raw-io @module @debug @cpu-emulation @obsolete
# ProtectProc/ProcSubset намеренно НЕ включены: приложению нужен полный /proc.
# Лимиты ресурсов, чтобы сканер не мешал работе сервера.
MemoryMax=256M
# Мягкий лимит для сборщика мусора Go: ближе к MemoryMax он собирает
# мусор чаще, вместо того чтобы служба упёрлась в лимит и была убита.
Environment=GOMEMLIMIT=200MiB
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
UMask=0077
# Без дампов памяти: в памяти службы бывают командные строки до
# маскирования секретов (строки Go нельзя затереть), и дамп при падении
# сохранил бы их на диск.
LimitCORE=0

[Install]
WantedBy=multi-user.target
