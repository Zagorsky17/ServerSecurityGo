# =====================================================================
# Настройки ServerSecurityGo.
#
# На сервере файл лежит в /opt/serversecuritygo/.env с правами 600 и
# читается systemd (EnvironmentFile). Скопируйте этот пример:
#   cp /opt/serversecuritygo/.env.example /opt/serversecuritygo/.env
#   chmod 600 /opt/serversecuritygo/.env
# После изменений перезапустите службу:
#   systemctl restart serversecuritygo
#
# Важно: комментарии пишите только на отдельных строках. Текст после
# значения (VAR=x # пояснение) станет частью значения.
# Все переменные необязательны: если строка закомментирована или пуста,
# используется значение по умолчанию, указанное в описании.
# =====================================================================

# --- Веб-панель ------------------------------------------------------

# Адрес и порт веб-панели.
# По умолчанию 127.0.0.1:8090 — панель доступна только с самого сервера.
# Рекомендуемый способ открыть её со своего компьютера — SSH-туннель:
#   ssh -L 8090:127.0.0.1:8090 root@<сервер>   и затем http://127.0.0.1:8090
# Если указать адрес, доступный из сети (0.0.0.0:8443 или IP сервера),
# служба НЕ запустится, пока не заданы SSG_AUTH_PASSWORD_HASH,
# SSG_ALLOWED_HOSTS и TLS (SSG_TLS_CERT/SSG_TLS_KEY или SSG_TRUST_PROXY_TLS).
SSG_LISTEN_ADDR=127.0.0.1:8090

# Unix-сокет, через который терминальный интерфейс (команда
# serversecuritygo на сервере) получает данные службы: полную историю,
# без пароля и SSH-туннеля. Доступ только у root: сокет создаётся с
# правами 600 в каталоге /run/serversecuritygo (700), его создаёт systemd.
# По умолчанию /run/serversecuritygo/api.sock. off — отключить сокет
# (тогда интерфейс будет сканировать сам, с историей только за сеанс).
# Если меняете путь, оставьте его внутри /run/serversecuritygo — только
# туда службе разрешена запись.
SSG_SOCKET_PATH=/run/serversecuritygo/api.sock

# Хеш пароля для входа в панель. Пусто — вход без пароля (допустимо только
# для адреса 127.0.0.1). Для доступа из сети обязателен.
# Получить хеш (пароль не короче 12 символов, вводится без отображения):
#   /opt/serversecuritygo/bin/serversecuritygo hash-password
# Команда выведет готовую строку SSG_AUTH_PASSWORD_HASH=... — вставьте её сюда.
# Сам пароль нигде не хранится, только хеш (PBKDF2-SHA256).
SSG_AUTH_PASSWORD_HASH=

# Время жизни сессии после входа (формат Go: 30m, 12h). По умолчанию 12h.
# Сессии хранятся в памяти: после перезапуска службы нужно войти заново.
SSG_SESSION_TTL=12h

# Сертификат и закрытый ключ TLS (PEM) для HTTPS прямо в приложении.
# Нужны, только если панель слушает сетевой адрес и перед ней нет
# reverse proxy с HTTPS. Задаются только вместе. Пример с Let's Encrypt:
#   SSG_TLS_CERT=/etc/letsencrypt/live/mon.example.com/fullchain.pem
#   SSG_TLS_KEY=/etc/letsencrypt/live/mon.example.com/privkey.pem
# Подводный камень: служба читает файлы при старте; после продления
# сертификата выполните systemctl restart serversecuritygo.
SSG_TLS_CERT=
SSG_TLS_KEY=

# true — TLS завершается на reverse proxy (nginx, Caddy), а приложение
# слушает внутренний адрес. Тогда cookie помечаются Secure, а проверка
# «нет TLS» при сетевом адресе отключается. По умолчанию false.
# Ставьте true, только если прокси действительно отдаёт панель по HTTPS.
SSG_TRUST_PROXY_TLS=false

# Допустимые значения заголовка Host через запятую: доменное имя или IP,
# по которому вы открываете панель (например, mon.example.com).
# localhost, 127.0.0.1 и ::1 разрешены всегда. Для доступа из сети
# обязательно. Защищает от атаки DNS rebinding: без этой проверки чужой
# сайт мог бы прочитать данные панели через ваш браузер.
SSG_ALLOWED_HOSTS=

# --- Сканирование ----------------------------------------------------

# Период сканирования процессов (формат Go: 10s, 30s, 1m). Минимум 2s.
# По умолчанию 30s. Чаще — точнее история, но выше нагрузка (на слабом
# сервере с сотнями процессов разумно 30s–60s).
SSG_SCAN_INTERVAL=30s

# Каталог истории (state.json и журнал событий events.jsonl).
# По умолчанию /var/lib/serversecuritygo — его создаёт systemd с правами 700.
# Менять стоит, только если меняете и ReadWritePaths в systemd-юните.
SSG_DATA_DIR=/var/lib/serversecuritygo

# Сколько хранить сведения о завершившихся процессах (формат Go). По умолчанию 168h (7 дней).
SSG_HISTORY_RETENTION=168h

# Максимальный размер журнала событий в мегабайтах. При превышении файл
# переименовывается в events.jsonl.1 (хранится одна старая копия), так что
# на диске занято не больше двух таких размеров. По умолчанию 20.
SSG_EVENTS_MAX_MB=20

# Порог загрузки CPU одним процессом, %, выше которого нагрузка считается
# высокой (100 = одно ядро полностью). По умолчанию 80.
SSG_CPU_THRESHOLD=80

# Сколько сканирований подряд процесс должен превышать порог CPU или RAM,
# чтобы появился признак «длительная нагрузка». По умолчанию 10
# (при интервале 30s это 5 минут). 0 — отключить признак.
SSG_CPU_SUSTAIN_SCANS=10

# Порог потребления памяти одним процессом, % от ОЗУ. По умолчанию 50.
SSG_MEM_THRESHOLD=50

# Файлы автозапуска (cron, systemd, authorized_keys), изменённые за
# последние N дней, отмечаются как «недавно изменённые». По умолчанию 7.
SSG_RECENT_DAYS=7

# Файл исключений (allowlist) для известных легитимных процессов в формате
# JSON. Пример — allowlist.example.json. Если файла нет, исключений нет.
# Подавленные признаки остаются видны в карточке процесса с пометкой.
SSG_ALLOWLIST_FILE=/opt/serversecuritygo/allowlist.json

# Сколько открытых файлов процесса показывать в карточке. Сокеты
# сопоставляются всегда, независимо от лимита. По умолчанию 200.
SSG_MAX_FILES_PER_PROCESS=200

# Корень /proc и корень файловой системы хоста. Менять не нужно; полезно
# только для отладки на снимке файловой системы. По умолчанию /proc и /.
SSG_PROC_ROOT=/proc
SSG_HOST_ROOT=/

# --- Журнал ----------------------------------------------------------

# Уровень подробности журнала: debug, info, warn, error. По умолчанию info.
# Журнал смотрите командой: journalctl -u serversecuritygo -f
# Пароли, cookie и полные командные строки в журнал не пишутся.
SSG_LOG_LEVEL=info
